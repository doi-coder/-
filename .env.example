# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워 넣으세요.
# .env 는 절대 git에 커밋되지 않습니다 (.gitignore 처리됨).

# 네이버 오픈API (developers.naver.com 에서 애플리케이션 등록 후 발급)
# - 검색 API(블로그) + 데이터랩(검색어트렌드) 둘 다 같은 Client ID/Secret 사용
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# YouTube Data API v3 키 (Google Cloud Console에서 발급, 무료)
YOUTUBE_API_KEY=

# Gmail 발신 계정 (2단계 인증 활성화 후 "앱 비밀번호" 발급해서 사용, 일반 로그인 비밀번호 아님)
GMAIL_ADDRESS=kkomi0301@gmail.com
GMAIL_APP_PASSWORD=

# 리포트를 받을 네이버 메일 주소
REPORT_RECIPIENT_EMAIL=
